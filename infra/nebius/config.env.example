# Copy to infra/nebius/config.env (git-ignored) and fill in. Sourced by every script in infra/nebius/.
# Values marked "Confirm with account" are explained in docs/VERIFIED.md.
NEBIUS_REGION=eu-north1
NEBIUS_SUBNET_ID=                 # nebius vpc subnet list --format jsonpath='{.items[0].metadata.id}'
CLEARANCE_REGISTRY_PATH=          # from `nebius registry create` (see build_push.sh)
CLEARANCE_IMAGE_TAG=0.1.0
CLEARANCE_S3_BUCKET=clearance-data
CLEARANCE_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud
CLEARANCE_S3_REGION=eu-north1
# Object Storage access key of the service account (create_bucket.sh prints these once).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# API operator token: required by every write route (sites, twins, Clearance checks, catalog review,
# live sessions). Generated and printed once by deploy_api_endpoint.sh when empty.
CLEARANCE_OPERATOR_TOKEN=
# Managed-URL tokens (only used with ENDPOINT_AUTH=token; generated by the deploy scripts when empty).
CLEARANCE_API_TOKEN=
CLEARANCE_VISION_TOKEN=
# Hugging Face token for gated Cosmos-Reason2-2B/8B weights (vision endpoint only).
HF_TOKEN=
