# Serverless Endpoint for the Clearance API + built web console (infra/Dockerfile.api).
# Flags: https://docs.nebius.com/cli/reference/ai/endpoint/create.md (docs/VERIFIED.md 2.11).
ENDPOINT_NAME=clearance-api
ENDPOINT_IMAGE_NAME=clearance-api
# Non-GPU platform. CPU-only endpoints: Confirm with account (run the deploy script with --dry-run).
ENDPOINT_PLATFORM=cpu-d3
ENDPOINT_PRESET=4vcpu-16gb
# Docs: at least 20Gi for CPU-only workloads.
ENDPOINT_DISK=30Gi
ENDPOINT_PORT=8000
# API auth is on: every write route needs CLEARANCE_OPERATOR_TOKEN (deploy_api_endpoint.sh sets it and
# CLEARANCE_DEPLOYED=1, which refuses to start without it). Phones use the site join token from the QR code and
# per-capture device tokens; read routes stay public so judges can browse the sample sites in a browser.
# The Nebius managed-URL token (ENDPOINT_AUTH=token) would also gate those public reads and the phones, so it
# stays off; set ENDPOINT_AUTH=token for a private deployment (the script then passes --token).
ENDPOINT_AUTH=none
# Reviews from the hosted console are kept in the database; the image's catalog JSON is never rewritten.
CLEARANCE_CATALOG_WRITEBACK=0
# WebSocket frames over 128 KiB are refused by uvicorn (--ws-max-size 131072 in the infra/Dockerfile.api CMD).
# WebSocket (/live) through the managed https:// URL: Confirm with account (docs/VERIFIED.md 2.12).
