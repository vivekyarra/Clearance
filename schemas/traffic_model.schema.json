{
  "$defs": {
    "TrafficZone": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Polygon",
          "type": "array"
        }
      },
      "required": [
        "id",
        "polygon"
      ],
      "title": "TrafficZone",
      "type": "object"
    }
  },
  "$id": "clearance/traffic_model",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Output of J5 or user estimate. od_pairs: (from_zone, to_zone, weight).",
  "properties": {
    "heatmap_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Heatmap Uri"
    },
    "od_pairs": {
      "default": [],
      "items": {
        "maxItems": 3,
        "minItems": 3,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ],
        "type": "array"
      },
      "title": "Od Pairs",
      "type": "array"
    },
    "persons_per_min": {
      "additionalProperties": {
        "type": "number"
      },
      "default": {
        "normal": 6.0,
        "peak": 14.0,
        "quiet": 2.0
      },
      "title": "Persons Per Min",
      "type": "object"
    },
    "source": {
      "default": "user_estimated",
      "enum": [
        "observed",
        "user_estimated"
      ],
      "title": "Source",
      "type": "string"
    },
    "walk_speed_mps": {
      "default": [
        1.2,
        0.25
      ],
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Walk Speed Mps",
      "type": "array"
    },
    "zones": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TrafficZone"
      },
      "title": "Zones",
      "type": "array"
    }
  },
  "title": "TrafficModel",
  "type": "object"
}
